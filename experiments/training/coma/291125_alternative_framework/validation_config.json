                    "api_key":"EMPTY",
                    "base_url":"http://0.0.0.0:8999/v1",
                    "model_name":"Qwen/Qwen3-VL-235B-A22B-Thinking",
                    "request_kwargs":{},
                    "max_workers":64,
                    "memory_to_dict_parser":{
                        "type":"MessagesMerger",
                        "base_parsers":[
