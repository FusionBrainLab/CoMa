                                    "type":"StringFormatDTCParser",
                                    "template":"Now, analyze the provided image:",
                                    "args_mapping":{},
                                    "modality":"text"
                                },
                                {
                                    "type":"ModalityKeyDTCParser",
                                    "modality":"image",
                                    "key":"pred_image"
                                }
                            ]
                        }
                    ]
                },
